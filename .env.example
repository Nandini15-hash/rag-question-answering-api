# Copy this file to .env and fill in values as needed.
# The system runs fully WITHOUT any API key (local embeddings + extractive fallback answerer).
# Set OPENAI_API_KEY to switch on real LLM-generated answers (and optionally OpenAI embeddings).

# --- LLM / generation ---
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4o-mini

# --- Embeddings ---
# "local" (recommended) uses sentence-transformers (all-MiniLM-L6-v2), no key needed,
#   runs on CPU, downloads the model from huggingface.co on first run only.
# "openai" uses text-embedding-3-small and requires OPENAI_API_KEY.
# "offline" uses a hashing-based bag-of-words vectorizer with NO network call ever —
#   lower retrieval quality, intended for locked-down/no-internet environments only.
EMBEDDING_PROVIDER=local

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4

# --- "Not in documents" handling ---
# Below this top-1 similarity, every generation mode short-circuits to an honest
# "not found in documents" answer (no LLM call spent on it). Query returns 200,
# not an error — it's a normal, expected outcome, not a failure.
MIN_SIMILARITY_FLOOR=0.05
# Above the floor, only the extractive fallback (no OPENAI_API_KEY) uses this as a
# hard cutoff, since it can't otherwise judge relevance. Default (0.16) is calibrated
# from real measurements against the offline hashing embedder (see EXPLANATION.md) —
# raise it (e.g. ~0.35) if you're using "local"/"openai" embeddings, whose semantic
# similarity scores separate relevant from irrelevant queries far more cleanly.
# NOT fully reliable with EMBEDDING_PROVIDER=offline even at this value — see
# EXPLANATION.md for the documented overlap between relevant/irrelevant score ranges.
SIMILARITY_THRESHOLD=0.16

# --- Rate limiting ---
RATE_LIMIT=20/minute

# --- Storage paths (relative to project root) ---
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index
JOB_DB_PATH=data/jobs.db
METRICS_LOG_PATH=data/metrics.jsonl
