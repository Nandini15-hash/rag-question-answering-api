# Copy this file to .env and fill in values as needed.
# The system runs fully WITHOUT any API key (local embeddings + extractive fallback answerer).
# Set OPENAI_API_KEY to switch on real LLM-generated answers (and optionally OpenAI embeddings).

# --- LLM / generation ---
OPENAI_API_KEY=
GENERATION_MODEL=gpt-4o-mini

# --- Embeddings ---
# "local" (recommended) uses sentence-transformers (all-MiniLM-L6-v2), no key needed,
#   runs on CPU, downloads the model from huggingface.co on first run only.
# "openai" uses text-embedding-3-small and requires OPENAI_API_KEY.
# "offline" uses a hashing-based bag-of-words vectorizer with NO network call ever —
#   lower retrieval quality, intended for locked-down/no-internet environments only.
EMBEDDING_PROVIDER=local

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4

# --- Rate limiting ---
RATE_LIMIT=20/minute

# --- Storage paths (relative to project root) ---
UPLOAD_DIR=data/uploads
INDEX_DIR=data/index
JOB_DB_PATH=data/jobs.db
METRICS_LOG_PATH=data/metrics.jsonl
